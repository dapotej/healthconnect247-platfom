# ── Demo (local development and the public demo site only) ──────────────
# Generated sample data and a demo sign-in page. NEVER set in production.
HC247_DEMO_MODE=true
# Fixed "now" for demo mode, so the data matches the mockups (Lagos time).
HC247_DEMO_NOW=2026-11-10T22:00:00+01:00

# ── Real data (Supabase) ────────────────────────────────────────────────
# Used when HC247_DEMO_MODE is not "true". The URL and publishable key are
# safe to expose to browsers.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# This site's address, used in invitation and password-reset emails.
# NEXT_PUBLIC_SITE_URL=https://<your-domain>
# Server-only secret key, needed only to send staff invitations. Set it in the
# hosting provider's settings as a sensitive variable; never commit it and
# never prefix it with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=
